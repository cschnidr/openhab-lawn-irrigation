// =============================================================================
// irrigation.items — Lawn irrigation system items
// =============================================================================
//
// Architecture note:
//   The user already has an EXISTING irrigation trigger switch in openHAB.
//   When that switch is ON, irrigation runs the next morning for a fixed,
//   manually-measured duration (deep irrigation).
//
//   This system does NOT replace that mechanism. It only DECIDES each evening
//   whether the trigger switch should be ON or OFF for the next morning.
//
// =============================================================================
//
// Groups
// ──────────────────────────────────────────────────────────────────────────────
Group gIrrigation          "Bewässerung"          <water>
Group gIrrigationWeather   "Wetter Bewässerung"   <sun_clouds>


// ── Weather inputs (from Things) ─────────────────────────────────────────────

// Yesterday's measured rain — used directly in the soil store balance
Number:Length IrrigationRainYesterday  "Regen gestern [%.1f mm]"  <rain>
    (gIrrigationWeather)
    { channel="exec:command:rainYesterday:output" }

// 7-day sum — diagnostic only, not used in the decision logic
Number:Length IrrigationRainLast7d    "Regen letzte 7 Tage [%.1f mm]"  <rain>
    (gIrrigationWeather)
    { channel="exec:command:rain7d:output" }

// Forecast temperatures (for ET₀ calculation)
Number        IrrigationTempMaxToday  "Tmax heute [%.0f °C]"           <temperature>
    (gIrrigationWeather)
    { channel="http:url:meteoSwissForecast:forecastTodayTempMax" }

Number        IrrigationTempMinToday  "Tmin heute [%.0f °C]"           <temperature>
    (gIrrigationWeather)
    { channel="http:url:meteoSwissForecast:forecastTodayTempMin" }

// Today's rain — at 05:00 this is mostly "already fallen" mixed with the
// remaining hours of forecast. Used to catch overnight rain that hasn't
// reached the measurement CSV yet (which only updates daily).
Number:Length IrrigationRainToday       "Regen heute [%.1f mm]"         <rain>
    (gIrrigationWeather)
    { channel="http:url:meteoSwissForecast:forecastTodayPrecip" }

// Forecast rain tomorrow (for skip-irrigation logic)
Number:Length IrrigationRainTomorrow    "Regen morgen [%.1f mm]"        <rain>
    (gIrrigationWeather)
    { channel="http:url:meteoSwissForecast:forecastTomorrowPrecip" }

Number:Length IrrigationRainTomorrowMax "Regen morgen max [%.1f mm]"   <rain>
    (gIrrigationWeather)
    { channel="http:url:meteoSwissForecast:forecastTomorrowPrecipMax" }


// ── Calculated state (updated by rule) ───────────────────────────────────────

// Virtual soil moisture store [mm] — MUST be persisted
// Without persistence, this resets to STORE_INITIAL_MM on every openHAB restart
// See docs/configuration.md for persistence setup.
Number:Length IrrigationSoilStore      "Bodenspeicher [%.1f mm]"       <cistern>
    (gIrrigation)

// Estimated evapotranspiration today [mm]
Number:Length IrrigationET0Today       "Verdunstung heute [%.1f mm]"   <sun>
    (gIrrigation)

// Human-readable explanation of the irrigation decision
String        IrrigationDecisionReason "Entscheidung [%s]"              <text>
    (gIrrigation)


// ── Trigger output ────────────────────────────────────────────────────────────

// IMPORTANT:
// This item refers to your EXISTING irrigation trigger switch.
// Do NOT define it here if it is already defined in another items file —
// instead, comment out the line below and adjust the rule to use your
// existing item name.
//
// If you currently don't have such a switch, define and link it here:
//
// Switch IrrigationTrigger "Bewässerung morgen aktiv"  <water>
//     (gIrrigation)
//     { channel="..." }   // ← link to your physical relay / valve trigger
//
// The decision rule does ONE thing with this item:
//   - sendCommand(ON)  if soil store is low and no rain expected tomorrow
//   - sendCommand(OFF) otherwise
//
// Duration and watering control are handled by your existing setup.
